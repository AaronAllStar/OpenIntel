# ==============================================================================
# OpenIntel Root .gitignore
# Security & Hygiene: Strict avoidance of secrets, binaries, DB dumps, and build caches
# ==============================================================================

# Rust & Cargo Build Artifacts
target/
**/*.rs.bk
*.pyd
*.so
*.dll
*.dylib

# Python & Maturin Artifacts
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Testing, Linting & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment, Secrets & Credentials (SECURITY CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
id_ed25519*
secrets/

# Databases, Storage & PostgreSQL Volumes
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
openintel.db
openintel.db*
openintel.sql
openintel_pgdata/
postgres_data/
data/db/
*.dump
*.sql.gz
!docker/init-db/*.sql

# Frontend & Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
src/ui/node_modules/
src/ui/dist/

# OSINT Exports & Local Artifacts
data/exports/*
!data/exports/.gitkeep
data/raw/*
!data/raw/.gitkeep
logs/
*.log

# IDE & OS Noise
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
