# Application Configuration
APP_NAME=OpenIntel
ENV=development
DEBUG=true
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars

# Server Binding (Localhost first)
HOST=127.0.0.1
PORT=8000

# Security
ALLOW_PRIVATE_TARGETS=false
ADAPTER_TIMEOUT_MS=30000
MAX_RESULTS_PER_ADAPTER=500

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://openintel:openintel_pass@127.0.0.1:5432/openintel

# Cache & Message Broker (Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Export Directory
EXPORTS_DIR=./data/exports
